{
  "config_version": 10,
  "daemon_data_dir": ".hamlet-data/sled",
  "podman_bin": "podman",
  "base_image": "docker.io/library/alpine:3.20",
  "web_listen_addr": "127.0.0.1:8787",
  "log_level": "info",
  "dispatch": {
    "enabled": false,
    "timeout_secs": 30,
    "url_allowlist": [],
    "max_attempts": 5,
    "backoff_initial_ms": 5000,
    "backoff_max_ms": 900000
  },
  "resources": {
    "memory": "512m",
    "cpus": "1.0",
    "pids_limit": 256
  },
  "sessions": {
    "ready_timeout_ms": 30000,
    "stop_grace_ms": 10000,
    "queue_depth": 64,
    "latency_spike_ms": 30000,
    "continue_on_restart": true,
    "restart": {
      "max_restarts": 5,
      "backoff_initial_ms": 1000,
      "backoff_max_ms": 60000
    }
  },
  "webhooks": {
    "enabled": false,
    "auth_env_key": "HAMLET_WEBHOOK_AUTH",
    "max_body_bytes": 65536,
    "routes": {}
  },
  "mayor": {
    "ack_timeout_ms": 30000,
    "wake_queue_depth": 16,
    "turn_timeout_ms": 120000,
    "crash_wake": "budget_exhausted",
    "escalation_webhook_url": null,
    "ack_retry_ms": 600000
  }
}
