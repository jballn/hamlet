#!/usr/bin/env bash
# pre-push hook: run the full CI battery before anything leaves the machine.
# Install: cp scripts/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
set -euo pipefail

# QA04-31: never exec a parse-corrupted battery (it would die without a
# verdict). Print the verdict here instead.
if ! bash -n "$(git rev-parse --show-toplevel)/scripts/ci.sh" 2>/dev/null; then
  printf '\n\033[1m== CI battery ==\033[0m\n'
  printf '  \033[1;31mFAIL\033[0m     scripts/ci.sh has a syntax error (parse-corrupted)\n'
  printf '\n\033[1;31mCI battery: FAIL (1)\033[0m\n'
  exit 2
fi

exec "$(git rev-parse --show-toplevel)/scripts/ci.sh"
